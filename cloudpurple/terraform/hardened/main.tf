# account_name and accounts come from hardened.auto.tfvars, generated by
# cloudpurple/scripts/hardened_ids.sh from the management account's Terraform output.

variable "ami_id" {
  type    = string
  default = "ami-03cf127a"
}

module "iam_baseline" {
  source     = "../../../terraform/modules/iam-baseline"
  account_id = var.accounts[var.account_name]
}

module "target" {
  source                   = "../modules/range-target"
  name                     = "hardened"
  account_id               = var.accounts[var.account_name]
  hardened                 = true
  permissions_boundary_arn = module.iam_baseline.boundary_policy_arn
  ami_id                   = var.ami_id
}

output "target" {
  value     = module.target.target
  sensitive = true
}